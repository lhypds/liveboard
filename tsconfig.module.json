{
  /* Shared TypeScript base for module repos (src/modules/*). Each module extends this from its own
     tsconfig.json, then owns the two things that used to leak into tsconfig.app.json:
       - `types`: global type packages the module needs (e.g. geojson, google.maps)
       - `exclude`: its own non-app code (python .venv dirs, node crawler scripts)
     Relative paths below resolve against THIS file's directory (the parent repo root), which is why
     the `paths` aliases keep working from inside a module. `include`/`exclude` do not inherit that
     way — they resolve against each module's own tsconfig, which is exactly what we want here. */
  /* The board's ambient declarations, which a module never includes on its own (its `include` is
     its own directory) but needs as soon as it imports through an alias: `@utils/sc` reaches a
     file that reads a build-time global, and without this the module's typecheck alone fails on
     it. `files` from a base config survives a child that only declares `include`, and both lists
     apply. */
  "files": [
    "./src/vite-env.d.ts"
  ],
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "esnext",
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    /* Path aliases — must mirror the `resolve.alias` block in vite.config.ts. No baseUrl (removed
       in TS 7): without it these resolve against this file's directory, i.e. the parent repo root. */
    "paths": {
      "@ui": [
        "./src/ui"
      ],
      "@ui/*": [
        "./src/ui/*"
      ],
      "@components": [
        "./src/components"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@pages/*": [
        "./src/pages/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@services/*": [
        "./src/services/*"
      ],
      "@utils/*": [
        "./src/utils/*"
      ],
      "@modules": [
        "./src/module.ts"
      ]
    },
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  }
}
